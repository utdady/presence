{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Presence",
  "version": "0.20.0",
  "identifier": "app.presence.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Presence Beta",
        "width": 1100,
        "height": 760,
        "minWidth": 420,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "shortDescription": "Presence Beta — live messaging and Nearby",
    "longDescription": "Presence (Beta): hub chat online; offline Nearby via Bluetooth RFCOMM on Windows/Android (Mac uses online Nearby rooms)."
  },
  "plugins": {}
}
