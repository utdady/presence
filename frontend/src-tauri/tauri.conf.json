{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Presence",
  "version": "0.1.0",
  "identifier": "app.presence.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Presence",
        "width": 1100,
        "height": 760,
        "minWidth": 420,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "shortDescription": "Presence — live messaging and Bluetooth Nearby",
    "longDescription": "Desktop Presence: hub chat online, offline Nearby via Bluetooth RFCOMM (Windows)."
  },
  "plugins": {}
}
